# t9-calloc.tr (Level 3): mm_calloc zeroes the block and refuses
# requests that overflow.


# Fill some blocks (the driver writes a pattern into every block) and
# free them, so the heap is full of old data.
a 0 100
a 1 200
a 2 300
a 3 400
a 4 64
a 5 64
a 6 1000
f 0
f 1
f 2
f 3
f 4
f 5
f 6

# calloc must return zeros even when it reuses a block with old data.
c 7 10 10
c 8 1 200
c 9 25 12
c 10 4 100
c 11 8 8
c 12 16 4
c 13 1 1000

# nmemb * size does not fit in 64 bits: calloc must return NULL.
# Multiplied anyway, these wrap around to 4 and 2 bytes.
c 14 4611686018427387905 4
c 15 3 6148914691236517206

# Bigger than the whole heap can ever be: NULL, not a crash.
c 16 1000000 1000
a 17 100000000

